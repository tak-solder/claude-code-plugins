{
  "description": "claude/ プレフィックスのブランチへの git commit をブロックする",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-branch.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
